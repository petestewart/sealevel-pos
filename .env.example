# Which studio the app talks to. "sandbox" (default) or "prod".
#
# Reaching the real studio's classes and students should be a choice someone
# made, never something they forgot to prevent.
MINDBODY_TARGET=sandbox

# Applies to prod ONLY; the sandbox always writes, since suppressing writes
# there would hide whether they work. With dry run on (the default), reads go
# to Mindbody normally and every write is logged and suppressed.
POS_DRY_RUN=true

# The safe way to test a write actually landing. Create a dummy client in
# Mindbody ("Test Test"), put its client id here, and with POS_DRY_RUN=false
# writes for anyone else are still suppressed. Leave empty in production,
# where no restriction is wanted.
POS_WRITE_CLIENT_IDS=

# --- Sandbox ---------------------------------------------------------
# Mindbody's site -99. Needs credentials issued FOR that site: staff accounts
# belong to a site, so the studio's own API login will not authenticate here.
MINDBODY_SANDBOX_API_KEY=
MINDBODY_SANDBOX_SITE_ID=-99
MINDBODY_SANDBOX_STAFF_USERNAME=
MINDBODY_SANDBOX_STAFF_PASSWORD=

# --- Production ------------------------------------------------------
# Sealevel Hot Yoga is site 471. Same credential pair the ai-manager worker
# holds. The staff account must be in a permission group granting
# LaunchSignInScreen and BookClassesAndEventsWithoutPayment (Phase 1), plus
# MakeSales, CreateRetailTickets, UseStoredCreditCards and
# AddProductsOnRetailScreen for Phase 2, and must have "Desk staff" ticked
# on its staff profile. See docs/design/front-desk-pos.md.
MINDBODY_PROD_API_KEY=
MINDBODY_PROD_SITE_ID=471
MINDBODY_PROD_STAFF_USERNAME=
MINDBODY_PROD_STAFF_PASSWORD=

# The unprefixed names still work as a fallback for production, so an older
# .env keeps running:
# MINDBODY_API_KEY=
# MINDBODY_SITE_ID=471
# MINDBODY_STAFF_USERNAME=
# MINDBODY_STAFF_PASSWORD=

# Optional. Defaults to the public v6 base url.
# MINDBODY_API_BASE_URL=https://api.mindbodyonline.com/public/v6

# Dev drawer: a bottom drawer listing every Mindbody call with its request
# and response. On automatically in a dev build; set true to enable it in a
# deployed build. Never enable it on the counter iPad, since the records
# carry client names and booking details.
POS_DEVTOOLS=false

# Studio banner: one line of announcement text shown across the top of the
# counter screen until it is changed (a workshop, a schedule change, a
# special). Set it on Railway; empty or unset shows no banner. No scheduling,
# no targeting. See the design doc's "Studio banner" section.
# POS_BANNER_TEXT=

# Shared PIN for the counter iPad (T21). Phase 1 has no per-teacher
# identity; see the design doc's open question 3.
#
# Unset or empty DISABLES auth entirely: every route answers without a
# session, which is right for local dev and is the pre-T21 behavior.
# Production MUST set it; a deployed app without it is an open endpoint
# against live student data. Digits are what the lock screen's keypad can
# enter. A correct PIN sets a signed 30-day session cookie; changing the
# PIN invalidates every outstanding session at once (the signing key is
# derived from the PIN), while a deploy restart does not log the iPad out.
POS_PIN=
