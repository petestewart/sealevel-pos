# Mindbody Public API v6. Same credential pair the ai-manager worker holds;
# the staff account must be in a permission group granting MakeSales,
# CreateRetailTickets, UseStoredCreditCards, AddProductsOnRetailScreen,
# LaunchSignInScreen and BookClassesAndEventsWithoutPayment, and must have
# "Desk staff" ticked on its staff profile. See the design doc in ai-manager
# (docs/design/front-desk-pos.md) for how that was established.
MINDBODY_API_KEY=
MINDBODY_SITE_ID=471
MINDBODY_STAFF_USERNAME=
MINDBODY_STAFF_PASSWORD=

# Optional. Defaults to the public v6 base url.
# MINDBODY_API_BASE_URL=https://api.mindbodyonline.com/public/v6

# Shared PIN for the counter iPad. Phase 1 has no per-teacher identity;
# see the design doc's open question 3.
POS_PIN=
