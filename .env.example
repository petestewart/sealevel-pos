# Copy to .env (gitignored). Never commit real values.
ANTHROPIC_API_KEY=

# Local dev (docker compose up -d). On Railway, use the values from the
# Postgres and Redis services instead (see docs/railway.md).
DATABASE_URL=postgres://ai_manager:ai_manager@localhost:5432/ai_manager
REDIS_URL=redis://localhost:6379

# Worker queue settings (defaults shown; both optional).
WORKER_CONCURRENCY=2
BULL_BOARD_PORT=3010

# Postgres backups (scripts/backup/pg-backup.sh, see docs/backups.md).
# Local dir for dump files; pruned to BACKUP_RETENTION newest dumps.
BACKUP_DIR=./backups
BACKUP_RETENTION=14
# Off-platform rclone destination (e.g. r2:sealevel-backups/pg). Unset = local only.
BACKUP_RCLONE_REMOTE=

# Clerk auth for the operator console (apps/console). Get both from the
# Clerk dashboard (dashboard.clerk.com > API keys). Required to run the
# console; placeholders here, never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# After signing in, set publicMetadata.role to "owner" or "operator" in the
# Clerk dashboard per user; users without a role are read-only viewers.

# Sealevel knowledge base MCP server (GH-57). The drafting and revise jobs
# consult the studio wiki through these read-only tools. Unset = the KB
# toolset is simply absent; jobs run without it. The token is the server's
# SERVICE_TOKEN (see the sealevel-mcp-server repo); never commit it.
SEALEVEL_MCP_URL=
SEALEVEL_MCP_TOKEN=
# KB write-back (GH-113): the SEPARATE kb-writer credential (the server's
# KB_WRITER_TOKEN wrangler secret, sealevel-mcp-server PR #26) used ONLY by
# the post-approval kb.write worker job to commit human-approved kb_update
# proposals via the gated write_wiki_page tool. The drafting toolset never
# sees it; the server scopes it to the write tool + reads. Unset = approvals
# are still recorded and the write job logs an honest "skipped" on the item.
SEALEVEL_MCP_KB_WRITER_TOKEN=
# Analytics reads (SEA-79): the SEPARATE analytics service credential (the
# server's ANALYTICS_TOKEN wrangler secret) used for campaign audience
# building. The server scopes it to the read-only D1 analytics tools
# (run_sql, teacher_performance, slot_performance, attendance_heatmap,
# monthly_financials) and nothing else; the drafting token can never reach
# them. Unset = the analytics toolset is simply absent. Reads are read-only,
# up to a day stale, capped at 200 rows per run_sql call (paginate), and
# must avoid 02:00-03:30 PT while the mirror rebuilds nightly.
SEALEVEL_MCP_ANALYTICS_TOKEN=

# Studio booking link. The one canonical URL customers use to book a class.
# When set, the drafting job tells the model to close a reply about a
# specific class, time, teacher, or availability with a booking invitation
# and this EXACT link (never invented or modified by the model). Unset = no
# booking rule is injected and drafting behaves as before. Public marketing
# URL, safe to commit as the example.
SEALEVEL_BOOKING_URL=https://sealevel-website.vercel.app/schedule

# Gmail email pipeline (GH-95, see docs/gmail-ingestion.md). The worker
# polls the studio inbox for unread mail (drafts a reply per message) and,
# on approval, sends the reply. All four below are REQUIRED for any Gmail
# activity; unset = the whole layer is inert (no polling, sending disabled),
# so local dev and tests never touch a real mailbox. Mint the refresh token
# with scripts/gmail/mint-refresh-token.mjs; never commit real values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
# Outbound send (defaults shown; all optional). GMAIL_SEND_ENABLED defaults
# OFF so provisioning credentials enables safe read-only ingestion without
# turning on delivery; set it to true (on BOTH worker and console) to let an
# approval actually send. The rest tune the poll.
GMAIL_SEND_ENABLED=false
# Outbound mode when send is enabled (GH-97): "send" delivers the reply
# (default), "draft" parks a Gmail draft to send manually from the Drafts
# folder (a safer middle ground; nothing reaches the customer automatically).
# Inert unless GMAIL_SEND_ENABLED=true. Set on BOTH worker and console.
GMAIL_SEND_MODE=send
GMAIL_INGEST_QUERY=in:inbox is:unread
GMAIL_INGEST_MAX=25
GMAIL_PROCESSED_LABEL=AI-Manager/Ingested
# Read = decided (locked 2026-07-19): ingestion leaves mail UNREAD (the
# processed label alone prevents re-ingestion); a message flips to read when
# its item is decided in the console (approve/reject/no-reply/trash/spam),
# via the email.gmailState worker job. Set true only to restore the old
# mark-read-at-ingestion behavior.
GMAIL_MARK_READ=false
GMAIL_POLL_CRON=*/2 * * * *

# Novu notifications (packages/core notifications, see docs/novu.md).
# Unset NOVU_SECRET_KEY = notifications are a logged no-op; local dev and
# tests never require a Novu account. Get the key from the Novu dashboard
# (Settings > API Keys). Subscriber ids must match the subscribers you
# create in Novu for each operator.
NOVU_SECRET_KEY=
NOVU_SUBSCRIBER_PETE=pete
NOVU_SUBSCRIBER_ALISON=alison
