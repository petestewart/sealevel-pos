# Which studio the app talks to. "sandbox" (default) or "prod".
#
# Reaching the real studio's classes and students should be a choice someone
# made, never something they forgot to prevent.
MINDBODY_TARGET=sandbox

# Applies to prod ONLY; the sandbox always writes, since suppressing writes
# there would hide whether they work. With dry run on (the default), reads go
# to Mindbody normally and every write is logged and suppressed.
POS_DRY_RUN=true

# The house/walk-in client for anonymous counter sales (Phase 2). Mindbody
# refuses to price or complete a sale with no client at all, so create a
# house client in Mindbody (e.g. "Counter Walk-in") and put its client id
# here; a sale with nobody attached is then recorded against it server-side
# while the screen still says "nobody". Unset, an anonymous cart shows only
# a local estimate and cannot be charged. During guarded testing
# (POS_DRY_RUN=false with POS_WRITE_CLIENT_IDS set) this id must be in
# POS_WRITE_CLIENT_IDS too, or every anonymous sale is suppressed.
POS_HOUSE_CLIENT_ID=

# The safe way to test a write actually landing. Create a dummy client in
# Mindbody ("Test Test"), put its client id here, and with POS_DRY_RUN=false
# writes for anyone else are still suppressed. Leave empty in production,
# where no restriction is wanted.
POS_WRITE_CLIENT_IDS=

# --- Sandbox ---------------------------------------------------------
# Mindbody's site -99. Needs credentials issued FOR that site: staff accounts
# belong to a site, so the studio's own API login will not authenticate here.
MINDBODY_SANDBOX_API_KEY=
MINDBODY_SANDBOX_SITE_ID=-99
MINDBODY_SANDBOX_STAFF_USERNAME=
MINDBODY_SANDBOX_STAFF_PASSWORD=

# --- Production ------------------------------------------------------
# Sealevel Hot Yoga is site 471. Same credential pair the ai-manager worker
# holds. The staff account must be in a permission group granting
# LaunchSignInScreen and BookClassesAndEventsWithoutPayment (Phase 1), plus
# MakeSales, CreateRetailTickets, UseStoredCreditCards and
# AddProductsOnRetailScreen for Phase 2, and must have "Desk staff" ticked
# on its staff profile. See docs/design/front-desk-pos.md.
MINDBODY_PROD_API_KEY=
MINDBODY_PROD_SITE_ID=471
MINDBODY_PROD_STAFF_USERNAME=
MINDBODY_PROD_STAFF_PASSWORD=

# The unprefixed names still work as a fallback for production, so an older
# .env keeps running:
# MINDBODY_API_KEY=
# MINDBODY_SITE_ID=471
# MINDBODY_STAFF_USERNAME=
# MINDBODY_STAFF_PASSWORD=

# Optional. Defaults to the public v6 base url.
# MINDBODY_API_BASE_URL=https://api.mindbodyonline.com/public/v6

# Dev drawer: a bottom drawer listing every Mindbody call with its request
# and response. On automatically in a dev build; set true to enable it in a
# deployed build. Never enable it on the counter iPad, since the records
# carry client names and booking details.
POS_DEVTOOLS=false

# Studio banner: one line of announcement text shown across the top of the
# counter screen until it is changed (a workshop, a schedule change, a
# special). Set it on Railway; empty or unset shows no banner. No scheduling,
# no targeting. See the design doc's "Studio banner" section.
# POS_BANNER_TEXT=

# Shared PIN for the counter iPad (T21). Teacher identity is separate
# (T48, below): nothing routine asks who is at the counter, and a COMP asks
# for the teacher's own PIN in the dialog whatever this is set to.
#
# Unset or empty DISABLES auth entirely: every route answers without a
# session, which is right for local dev and is the pre-T21 behavior.
# Production MUST set it; a deployed app without it is an open endpoint
# against live student data. Digits are what the lock screen's keypad can
# enter. A correct PIN sets a signed 30-day session cookie; changing the
# PIN invalidates every outstanding session at once (the signing key is
# derived from the PIN), while a deploy restart does not log the iPad out.
POS_PIN=

# Random secret mixed into the session-cookie signing key (T21 review).
# Without it the key derives from the PIN alone, so one captured cookie
# lets an attacker brute-force a short PIN offline in minutes. Set it in
# production to something long and random (e.g. `openssl rand -hex 32`);
# it is never typed by anyone. Changing it, like changing the PIN, logs
# every device out at once. Unset keeps the PIN-only derivation, which is
# fine for local dev. It is ALSO the key under which teacher PINs are
# indexed (T48): changing it orphans every stored PIN and teachers enroll
# again, so set it once and keep it.
# POS_SESSION_SECRET=

# --- Teacher PINs (T48) ----------------------------------------------
# Every comp asks "Who is comping this?" and takes a teacher's PIN, 4 to 6
# digits, chosen by the teacher and stored HASHED in the database
# (teacher_pins, migration 5), unique across teachers. A teacher sets or
# changes theirs from the comp dialog by signing in to Mindbody once
# (their own username and password, checked against /usertoken/issue and
# kept nowhere). A staff member with no Mindbody login gets one set through
# PUT /api/admin/teacher-pins {staffId, pin} with POS_DEVTOOLS on.
#
# No phone numbers are read or used anywhere (T44's last-four scheme is
# gone: not everyone has a phone on file, and two people can share four
# digits).
#
# DEV ONLY: with no DATABASE_URL, a "<staffId>:<pin>" list stands in for the
# table so the comp dialog can be exercised locally. Refused (ignored, with
# a warning) when MINDBODY_TARGET=prod: the studio's counter must have the
# real store or refuse to comp. A PIN listed twice names nobody.
# POS_TEACHER_PINS=100:1234,106:5678

# --- Database (T29, optional) ----------------------------------------
# Postgres, holding ONLY what Mindbody has no home for: waiver receipts,
# bundle config, banner text, promo entitlements. Never clients, classes,
# passes, prices or visits -- see the charter in src/lib/db.ts.
#
# UNSET = FULL FALLBACK MODE, and that is the default for local work:
# bundles come from src/lib/bundles.ts, waiver receipts go to Notes + the
# server log, the banner comes from POS_BANNER_TEXT, promo entitlements
# are simply absent. Nothing breaks and nothing nags; /api/config reports
# storage: "none" and the dev drawer's settings tab shows it.
#
# To test DB features locally (docker-compose.yml in this repo):
#   docker compose up -d
#   DATABASE_URL=postgres://pos:pos@localhost:5432/sealevel_pos npm run dev
#
# On Railway, add a Postgres service and reference its variable:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# The schema migrates itself (idempotent plain SQL) on first use, never at
# build. A database that is configured but unreachable degrades to the
# same fallbacks, logged once per failure kind.
# DATABASE_URL=
