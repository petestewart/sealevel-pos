{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build -w @ai-manager/core -w @ai-manager/worker"
  },
  "deploy": {
    "startCommand": "npm run start -w @ai-manager/worker",
    "preDeployCommand": "node packages/core/dist/db/migrate.js",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
