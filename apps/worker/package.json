{
  "name": "@ai-manager/worker",
  "version": "0.0.1",
  "private": true,
  "description": "Heartbeat + BullMQ workers + brain (always-on). Placeholder entry point; queue/brain wiring lands in later Phase 0 tickets.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "fire:email-draft": "npm run build && node dist/fire.js",
    "ingest:once": "npm run build && node dist/ingest.js"
  },
  "dependencies": {
    "@ai-manager/core": "0.0.1",
    "@ai-manager/features": "0.0.1",
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
