{
  "name": "@ai-manager/core",
  "version": "0.0.1",
  "private": true,
  "description": "Shared core: brain, queue, tools, jobs, db. Placeholder module; implementations land in later Phase 0 tickets.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "migrate": "npm run build && node dist/db/migrate.js",
    "smoke": "npm run build && node dist/db/smoke.js",
    "smoke:brain": "npm run build && node dist/brain/smoke.js",
    "smoke:novu": "npm run build && node dist/notifications/smoke.js",
    "smoke:revise": "npm run build && node dist/jobs/itemRevise.smoke.js",
    "smoke:items": "npm run build && node dist/db/smokeItems.js",
    "smoke:gmail": "npm run build && node dist/gmail/gmail.smoke.js",
    "smoke:emailhistory": "npm run build && node dist/tools/emailHistory.smoke.js",
    "smoke:gmailstate": "npm run build && node dist/gmail/state.smoke.js",
    "smoke:spamtrash": "npm run build && node dist/db/spamTrash.smoke.js",
    "smoke:reviewqueue": "npm run build && node dist/db/reviewQueue.smoke.js",
    "smoke:kbwriteback": "npm run build && node dist/kb/kbWriteBack.smoke.js",
    "smoke:booking": "npm run build && node dist/booking.smoke.js",
    "smoke:evals": "npm run build && node dist/evals/evals.smoke.js",
    "eval": "npm run build && node dist/evals/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@novu/api": "^3.18.0",
    "bullmq": "^5.79.3",
    "ioredis": "^5.10.1",
    "pg": "^8.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6"
  }
}
