{
  "name": "@ai-manager/features",
  "version": "0.0.1",
  "private": true,
  "description": "Vertical feature slices (email, social, analytics, expenses). Placeholder module; features land in later tickets.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "smoke:payrollcompute": "npm run build && node dist/payroll/compute.smoke.js",
    "smoke:payrollfiling": "npm run build && node dist/payroll/filing.smoke.js",
    "smoke:payrollfreshness": "npm run build && node dist/payroll/freshness.smoke.js",
    "smoke:payrollprepare": "npm run build && node dist/payroll/prepare.smoke.js",
    "smoke:payrollsync": "npm run build && node dist/payroll/sync.smoke.js"
  },
  "dependencies": {
    "@ai-manager/core": "0.0.1"
  }
}
